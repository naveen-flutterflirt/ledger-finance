# ==============================================================================
# LedgerPilot Backend - Vercel / Production Environment Template (.env.example)
# ==============================================================================

# Server Port (optional on Vercel, defaults to 5000 or process.env.PORT)
PORT=5000

# Set to 'production' on Vercel
NODE_ENV=production

# Neon PostgreSQL connection string (include ?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:<password>@<neon-host>/neondb?sslmode=require

# Strong random secret key for JWT session cookies (at least 32 characters)
JWT_SECRET=replace-this-with-a-secure-random-64-character-string

# Production frontend URL(s) without trailing slash, comma-separated
CORS_ORIGINS=https://your-frontend-app.vercel.app

